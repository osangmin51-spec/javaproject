{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "Run MiniProjectApp",
      "request": "launch",
      "mainClass": "MiniProjectApp",
      "args": "8080",
      "cwd": "${workspaceFolder}",
      "classPaths": [
        "${workspaceFolder}/out",
        "${workspaceFolder}/lib/*"
      ],
      "preLaunchTask": "compile MiniProjectApp"
    }
  ]
}
