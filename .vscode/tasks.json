{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "compile MiniProjectApp",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "$sources = Get-ChildItem -Path src\\main\\java -Recurse -Filter *.java | ForEach-Object { $_.FullName }; javac -encoding UTF-8 -d out $sources"
      ],
      "group": "build",
      "problemMatcher": "$javac"
    },
    {
      "label": "start MiniProjectApp server",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\start-server.ps1",
        "-Port",
        "8080"
      ],
      "runOptions": {
        "runOn": "folderOpen"
      },
      "problemMatcher": []
    },
    {
      "label": "stop MiniProjectApp server",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\stop-server.ps1",
        "-Port",
        "8080"
      ],
      "problemMatcher": []
    }
  ]
}
